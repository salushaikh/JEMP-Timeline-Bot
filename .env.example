# GEMINI_API_KEY: Required for Gemini AI API calls (server-side).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Discord Bot Credentials
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=

# Shared Database (PostgreSQL)
# Can be postgresql://user:password@host:5432/dbname.
# If unset in development, the bot utilizes embedded PostgreSQL (PGlite) automatically.
DATABASE_URL=

# Service-to-Service Authentication Secret
# Shared with Onboarding, Project, Brainstorm, Client/Hiring, and Payroll bots
TIMELINE_SERVICE_SECRET="jemp-timeline-shared-secret-key"

# Discord Channel & Role Configurations
PROFILE_MANAGER_CHANNEL_ID=
TIMELINE_CHANNEL_ID=
ADMIN_LOG_CHANNEL_ID=
ADMIN_ROLE_ID=

# Public Share Configuration
PUBLIC_SHARE_BASE_URL=https://despair.us/timeline/share
SHARE_EXPIRY_HOURS=24

# Security and Rate Limiting
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=100
MAX_EXPORT_SIZE_MB=15

NODE_ENV=development
LOG_LEVEL=info
